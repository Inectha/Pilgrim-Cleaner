<ui:FluentWindow x:Class="LuminaCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:LuminaCleaner"
        xmlns:vm="clr-namespace:LuminaCleaner.ViewModels"
        xmlns:ctrl="clr-namespace:LuminaCleaner.Controls"
        xmlns:models="clr-namespace:LuminaCleaner.Models"
        mc:Ignorable="d"
        Title="Pilgrim Cleaner"
        Height="820" Width="1240"
        MinHeight="700" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="#080E17"
        Foreground="#F1F5F9"
        FontSize="15"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar Row -->
            <RowDefinition Height="Auto" />
            <!-- Main Application Body -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP TITLE BAR (Single Consolidated Pilgrim Software Brand Integration) -->
        <Border Grid.Row="0" Background="#0C1522" BorderBrush="#162538" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Standard Native Windows Title Controls & Full-Width Drag Surface -->
                <ui:TitleBar Grid.Column="0"
                             Grid.ColumnSpan="3"
                             Title=""
                             Height="46"
                             CloseWindowByDoubleClickOnIcon="False" />

                <!-- Single Brand Header Top-Left: Logo + Pilgrim Cleaner -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                    <!-- Stylized High-Contrast Mathematical Vector Logo -->
                    <ctrl:PilgrimLogoControl Width="28" Height="28" ShowSquircleBackground="True" GlowOpacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center">
                        <ctrl:PilgrimLogoControl.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#00E5FF" Opacity="0.55" ShadowDepth="0" />
                        </ctrl:PilgrimLogoControl.Effect>
                    </ctrl:PilgrimLogoControl>
                    <TextBlock Text="Pilgrim" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <TextBlock Text="Cleaner" FontWeight="Light" FontSize="16" Foreground="#00E5FF" Margin="5,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#14263C" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.1" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" />
                    </Border>
                </StackPanel>

                <!-- Center Activity Status Pill -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#0E1929" BorderBrush="#1C3048" BorderThickness="1" CornerRadius="12" Padding="12,3"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#00E5FF" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#00E5FF" Opacity="0.9" ShadowDepth="0" />
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="{Binding CurrentStatusText}" FontSize="14" Foreground="#CBD5E1" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- APPLICATION BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Navigation Sidebar -->
                <ColumnDefinition Width="248" />
                <!-- Main Content Stage -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================== SIDEBAR ===================== -->
            <Border Grid.Column="0" Background="#0B131F" BorderBrush="#142234" BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Sidebar Navigation Buttons (Categorized & Badged) -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical">
                        <!-- SECTION 1: STORAGE & CLEANUP -->
                        <TextBlock Text="STORAGE &amp; CLEANUP" FontSize="11.5" FontWeight="Bold" Foreground="#475569" Margin="12,0,0,6" />

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Dashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Modules, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Modules">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Grid.Column="1" Text="Storage Modules" VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Background="#16273C"
                                        CornerRadius="8"
                                        Padding="6,1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding TotalRecoverableBytes, Converter={StaticResource NumberToVis}}">
                                    <TextBlock Text="{Binding FormattedRecoverableBytes}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=SpaceLens, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="SpaceLens">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Text="Space Lens" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Duplicates, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Duplicates">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Copy24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Text="Duplicates" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- SECTION 2: SYSTEM MANAGEMENT -->
                        <TextBlock Text="SYSTEM MANAGEMENT" FontSize="11.5" FontWeight="Bold" Foreground="#475569" Margin="12,14,0,6" />

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Applications, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Applications">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Apps24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Grid.Column="1" Text="Applications" VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Background="#16273C"
                                        CornerRadius="8"
                                        Padding="6,1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding AppManager.TotalAppsCount, Converter={StaticResource NumberToVis}}">
                                    <TextBlock Text="{Binding AppManager.TotalAppsCount}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Drivers, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Drivers">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="DeveloperBoard24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Grid.Column="1" Text="Driver Health" VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Background="#112B20"
                                        BorderBrush="#00FF9D"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="5,1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="WHQL" FontSize="11" FontWeight="Bold" Foreground="#00FF9D" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Startup, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Startup">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Text="Startup Boot" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- SECTION 3: VITALS & PRIVACY -->
                        <TextBlock Text="VITALS &amp; PRIVACY" FontSize="11.5" FontWeight="Bold" Foreground="#475569" Margin="12,14,0,6" />

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Telemetry, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Telemetry">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Heart24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Text="System Vitals" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Privacy, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Privacy">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Shield24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Text="Privacy Shield" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- SECTION 4: DIAGNOSTICS & SETTINGS -->
                        <TextBlock Text="DIAGNOSTICS &amp; ABOUT" FontSize="11.5" FontWeight="Bold" Foreground="#475569" Margin="12,14,0,6" />

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Terminal, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Terminal">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="WindowConsole20" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Text="Action Terminal" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Scheduler, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Scheduler">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Timer24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Text="Automation" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=Help, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Help">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Text="User Manual &amp; Help" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource StringToBool}, ConverterParameter=About, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="About">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" FontSize="20" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                <TextBlock Text="About Pilgrim" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Elevation & Safety Status -->
                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <!-- Guardrail indicator card -->
                        <Border Background="#101C2B" BorderBrush="#1C2E44" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="16" Margin="0,0,8,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Safety Buffer Active" FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0" />
                                    <TextBlock Text="24h Temp Protection" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Elevation card -->
                        <Border Background="#101C2B" BorderBrush="#1C2E44" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Shield24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="16" Margin="0,0,8,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ElevationStatusText}" FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0" />
                                    <TextBlock Text="Zero Registry Tamper" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== MAIN STAGE ===================== -->
            <Grid Grid.Column="1" Background="#090F18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ==================== VIEW 1: DASHBOARD ==================== -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Dashboard}">
                    <Grid Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <!-- Hero Section (Donut Gauge & Quick Actions) -->
                            <RowDefinition Height="Auto" />
                            <!-- Summary Stat Cards -->
                            <RowDefinition Height="Auto" />
                            <!-- Protected Storage Telemetry Card -->
                            <RowDefinition Height="Auto" />
                            <!-- Module Quick Strip -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- HERO DONUT GAUGE CARD -->
                        <Border Grid.Row="0" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header row inside card -->
                                <Grid Grid.Row="0" Margin="4,0,4,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="STORAGE HEALTH AUDIT" FontWeight="Bold" FontSize="14" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               Text="{Binding CurrentStatusText}"
                                               FontSize="13.5"
                                               Foreground="#00E5FF"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="420" />
                                </Grid>

                                <!-- Central Donut Gauge (Hardware-accelerated 60 FPS arc) -->
                                <ctrl:DonutGaugeControl Grid.Row="1"
                                                        Height="260"
                                                        Value="{Binding GaugeFillRatio}"
                                                        PrimaryText="{Binding FormattedRecoverableBytes}"
                                                        SecondaryText="Recoverable Storage"
                                                        StatusBadgeText="{Binding CurrentModuleName}"
                                                        Margin="0,8,0,16" />

                                <!-- Action Buttons & Progress Bar -->
                                <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center">
                                    <!-- Progress Bar (Always 100% when Audit Complete or Purged) -->
                                    <Grid Width="520" Margin="0,0,0,16" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="3" ClipToBounds="True" Background="#18273A" Height="6">
                                            <ProgressBar Value="{Binding CleanProgressPercentage}"
                                                         Foreground="{StaticResource BrushPilgrimCyan}"
                                                         Background="Transparent"
                                                         BorderThickness="0" />
                                        </Border>
                                        <Grid Grid.Row="1" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding CurrentStatusText}"
                                                       FontSize="13"
                                                       Foreground="#94A3B8"
                                                       HorizontalAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="440" />
                                            <TextBlock Text="{Binding CleanProgressPercentage, StringFormat='{}{0:N0}%'}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="#00E5FF"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </Grid>

                                    <!-- Main Buttons Bar -->
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Primary Scan / Re-Scan Button -->
                                        <Button Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                                Command="{Binding StartScanCommand}"
                                                Visibility="{Binding CanScan, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="16" Margin="0,0,8,0" />
                                                <TextBlock Text="Audit System Storage" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Clean Selected Targets Button -->
                                        <Button Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                                Command="{Binding StartCleanCommand}"
                                                Visibility="{Binding CanClean, Converter={StaticResource BoolToVis}}"
                                                Background="{StaticResource BrushPilgrimGlowButton}"
                                                Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding FormattedRecoverableBytes, StringFormat='Purge Selected ({0})'}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Review Items Button -->
                                        <Button Background="#162538"
                                                BorderBrush="#253850"
                                                BorderThickness="1"
                                                Foreground="#E2E8F0"
                                                FontWeight="SemiBold"
                                                FontSize="14.5"
                                                Padding="20,11"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Modules"
                                                Margin="0,0,12,0"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Filter24" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource BrushPilgrimCyan}" />
                                                <TextBlock Text="Review &amp; Select" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Cancel Button (Active when busy) -->
                                        <Button Background="#381616"
                                                BorderBrush="#552222"
                                                BorderThickness="1"
                                                Foreground="#FF8888"
                                                FontWeight="Bold"
                                                Padding="18,11"
                                                Command="{Binding CancelOperationCommand}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Margin="0,0,8,0" />
                                                <TextBlock Text="Cancel" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- SUMMARY STAT CARDS (3 Columns) -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Files Analyzed -->
                            <Border Grid.Column="0" Style="{StaticResource PilgrimCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FILES AUDITED" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding TotalFilesAnalyzed, StringFormat='{}{0:N0}'}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="Across active modules" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" Background="#16273C" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="24" Foreground="{StaticResource BrushPilgrimCyan}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card 2: Space Recovered Lifetime -->
                            <Border Grid.Column="2" Style="{StaticResource PilgrimCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="STORAGE RECOVERED" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding FormattedLifetimeRecovered}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushPilgrimEmerald}"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="Reclaimed by Pilgrim Cleaner" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" Background="#143026" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="24" Foreground="{StaticResource BrushPilgrimEmerald}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card 3: Cleanliness Score -->
                            <Border Grid.Column="4" Style="{StaticResource PilgrimCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="STORAGE HYGIENE" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding CleanlinessScore, StringFormat='{}{0}%'}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushPilgrimCyan}"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="Safe enterprise score" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" Background="#16273C" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Shield24" FontSize="24" Foreground="{StaticResource BrushPilgrimCyan}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- PROTECTED STORAGE & SAFETY GUARDRAILS CARD (Explicit Skip Explanation) -->
                        <Border Grid.Row="2" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="#1B2636" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="24" Foreground="{StaticResource BrushPilgrimCyan}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PROTECTED STORAGE &amp; GUARDRAILS" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                        <Border Background="#16273C" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding TotalSkippedFiles, StringFormat='{}{0:N0} Files Preserved'}" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SkippedExplanation}" FontSize="14" Foreground="#E2E8F0" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="• Temp files &lt; 24h old: Preserved to protect running installers" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,16,0" />
                                        <TextBlock Text="• In-use files: Gracefully bypassed" FontSize="12.5" Foreground="#94A3B8" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Skipped Size Badge -->
                                <Border Grid.Column="2"
                                        Background="#122336"
                                        BorderBrush="#00E5FF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,10"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedSkippedBytes}" FontSize="17" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Protected / Skipped" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- QUICK MODULE STATUS STRIP -->
                        <Border Grid.Row="3" Style="{StaticResource PilgrimCardStyle}">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="MODULE STORAGE BREAKDOWN" FontSize="13.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding Modules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0E1826"
                                                    BorderBrush="#182A3E"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14,10"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#16263B" Margin="0,0,12,0">
                                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="20" Foreground="{StaticResource BrushPilgrimCyan}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#F1F5F9" />
                                                        <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="440" />
                                                    </StackPanel>

                                                    <!-- Protected badge if any files skipped -->
                                                    <Border Grid.Column="2"
                                                            Background="#141E2D"
                                                            BorderBrush="#334155"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,4"
                                                            Margin="8,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedSkippedSize, StringFormat='{}Protected: {0}'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                    </Border>

                                                    <!-- Recoverable Size Badge -->
                                                    <Border Grid.Column="3"
                                                            Background="#14263C"
                                                            BorderBrush="#00E5FF"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="10,4"
                                                            Margin="4,0,16,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedTotalSize}" FontWeight="Bold" FontSize="13.5" Foreground="#00E5FF" />
                                                    </Border>

                                                    <!-- Toggle Switch -->
                                                    <ui:ToggleSwitch Grid.Column="4"
                                                                     IsChecked="{Binding IsEnabled}"
                                                                     VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ==================== VIEW 2: MODULES & ACCORDION EXPANDER ==================== -->
                <Grid Grid.Row="0" Margin="28,24,28,24" Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Modules}">
                    <Grid.RowDefinitions>
                        <!-- Header with Bulk Select Buttons -->
                        <RowDefinition Height="Auto" />
                        <!-- Scrollable Accordion Cards List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="STORAGE TARGET AUDIT" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Inspect discovered files, verify protected buffers, and select categories for execution." FontSize="14" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Background="#142436"
                                    Foreground="#00E5FF"
                                    BorderBrush="#20354D"
                                    BorderThickness="1"
                                    FontWeight="SemiBold"
                                    Padding="14,8"
                                    Command="{Binding SelectAllModulesCommand}"
                                    CommandParameter="True"
                                    Margin="0,0,8,0"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Select All" />
                                </StackPanel>
                            </Button>

                            <Button Background="#142436"
                                    Foreground="#94A3B8"
                                    BorderBrush="#20354D"
                                    BorderThickness="1"
                                    FontWeight="SemiBold"
                                    Padding="14,8"
                                    Command="{Binding SelectAllModulesCommand}"
                                    CommandParameter="False"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Deselect All" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable Module Accordions -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Modules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,16">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0" Padding="0">
                                            <Expander.Header>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#16283E" Margin="0,0,14,0">
                                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="20" Foreground="{StaticResource BrushPilgrimCyan}" />
                                                    </Border>

                                                    <!-- Title & Security Notice -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />
                                                            <Border Background="#123026" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ItemCount, StringFormat='{}{0:N0} recoverable'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimEmerald}" />
                                                            </Border>
                                                            <Border Background="#1B2838" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SkippedCount, StringFormat='{}{0:N0} protected'}" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SecurityNotice}" FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding SkippedReasonSummary}" FontSize="12" Foreground="#00E5FF" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- Protected Badge -->
                                                    <Border Grid.Column="2"
                                                            Background="#141E2D"
                                                            BorderBrush="#334155"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="10,5"
                                                            Margin="8,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedSkippedSize, StringFormat='{}Protected: {0}'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                    </Border>

                                                    <!-- Selected Size Badge -->
                                                    <Border Grid.Column="3"
                                                            Background="#14283E"
                                                            BorderBrush="#00E5FF"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="12,5"
                                                            Margin="4,0,16,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedSelectedSize, StringFormat='{}Selected: {0}'}" FontWeight="Bold" FontSize="13.5" Foreground="#00E5FF" />
                                                    </Border>

                                                    <!-- Toggle Switch -->
                                                    <ui:ToggleSwitch Grid.Column="4"
                                                                     IsChecked="{Binding IsEnabled}"
                                                                     VerticalAlignment="Center" />
                                                </Grid>
                                            </Expander.Header>

                                            <!-- Expanded Content: Virtualized File List with explicit skip reasons -->
                                            <Border Background="#09101A" BorderBrush="#16273A" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0" Padding="10">
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="DISCOVERED CANDIDATES &amp; PROTECTED FILES (DRY-RUN AUDIT TREE)" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="4,0,0,8" />

                                                    <!-- Empty state indicator -->
                                                    <TextBlock Text="No files found or target directory is completely clean."
                                                               FontSize="13.5"
                                                               Foreground="#64748B"
                                                               Margin="10,14"
                                                               HorizontalAlignment="Center"
                                                               Visibility="{Binding DiscoveredItems.Count, Converter={StaticResource StringToVis}, ConverterParameter=0}" />

                                                    <!-- Virtualized Items List -->
                                                    <ItemsControl ItemsSource="{Binding DiscoveredItems}"
                                                                  MaxHeight="300"
                                                                  VirtualizingPanel.IsVirtualizing="True"
                                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                                  ScrollViewer.CanContentScroll="True">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VirtualizingStackPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.Template>
                                                            <ControlTemplate TargetType="ItemsControl">
                                                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                                                    <ItemsPresenter />
                                                                </ScrollViewer>
                                                            </ControlTemplate>
                                                        </ItemsControl.Template>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="#142030" BorderThickness="0,0,0,1" Padding="8,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <CheckBox Grid.Column="0"
                                                                                  IsChecked="{Binding IsSelected}"
                                                                                  IsEnabled="{Binding Status, Converter={StaticResource StringToVis}, ConverterParameter=Scanned}"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="0,0,10,0" />

                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14.5" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding FullPath}" FontSize="13" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                                            <!-- Reason why file was skipped / protected -->
                                                                            <TextBlock Text="{Binding SkipReason, StringFormat='{}Reason: {0}'}"
                                                                                       FontSize="13"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="#FFB800"
                                                                                       Visibility="{Binding SkipReason, Converter={StaticResource BoolToVis}}" />
                                                                        </StackPanel>

                                                                        <!-- Age badge -->
                                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedAge}" FontSize="14" Foreground="#94A3B8" Margin="10,0" VerticalAlignment="Center" />

                                                                        <!-- File size -->
                                                                        <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" Margin="10,0" VerticalAlignment="Center" />

                                                                        <!-- Status Pill -->
                                                                        <Border Grid.Column="4" Background="#142030" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Status}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding Status, Converter={StaticResource CleanStatusToBrush}}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== VIEW 3: TERMINAL / ACTION LOG ==================== -->
                <Grid Grid.Row="0" Margin="28,24,28,24" Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Terminal}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Terminal Controls Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="WindowConsole20" FontSize="20" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,0,10,0" />
                            <TextBlock Text="OPERATIONAL ACTION LOG" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <Border Background="#142436" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActionLogs.Count, StringFormat='{}{0} Events'}" FontSize="12.5" FontWeight="Bold" Foreground="#00E5FF" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Background="#142232"
                                    BorderBrush="#20344A"
                                    BorderThickness="1"
                                    Foreground="#94A3B8"
                                    Padding="14,6"
                                    FontWeight="SemiBold"
                                    Command="{Binding ClearLogsCommand}"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Clear Log" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Monospace High-Contrast Log Window -->
                    <Border Grid.Row="1"
                            Background="#060A10"
                            BorderBrush="#182A3E"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ActionLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Consolas, Cascadia Code, monospace"
                                                   FontSize="13.5"
                                                   Margin="0,2"
                                                   LineHeight="18">
                                            <Run Text="[" Foreground="#475569" /><Run Text="{Binding FormattedTimestamp, Mode=OneWay}" Foreground="#64748B" /><Run Text="]" Foreground="#475569" />
                                            <Run Text=" " />
                                            <Run Text="{Binding Tag, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding AccentColor, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding Message, Mode=OneWay}" Foreground="#E2E8F0" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ==================== VIEW 3: APPLICATION MANAGER (UNINSTALLER) ==================== -->
                <Grid Grid.Row="0"
                      Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Applications}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header & Metric Cards -->
                    <StackPanel Grid.Row="0" Margin="28,24,28,0">
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Apps24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Applications &amp; Software Manager" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Audit installed 64-bit/32-bit Win32 software and Windows Store packages with deep residue cleaning." FontSize="14" Foreground="#94A3B8" Margin="34,2,0,0" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                    Command="{Binding AppManager.RefreshApplicationsCommand}"
                                    Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="15" Margin="0,0,8,0" />
                                    <TextBlock Text="Rescan Software" FontWeight="Bold" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Stat Cards Grid -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Total Apps -->
                            <Border Grid.Column="0" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,8,0" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Apps24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="TOTAL INSTALLED" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AppManager.TotalAppsCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Programs Cataloged" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Total Storage -->
                            <Border Grid.Column="1" Style="{StaticResource PilgrimCardStyle}" Margin="4,0,4,0" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="HardDrive24" Foreground="{StaticResource BrushPilgrimTeal}" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="STORAGE FOOTPRINT" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AppManager.TotalSizeText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimCyan}" />
                                    <TextBlock Text="Installed App Volume" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Packaged Apps -->
                            <Border Grid.Column="2" Style="{StaticResource PilgrimCardStyle}" Margin="4,0,4,0" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="StoreMicrosoft24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="STORE PACKAGES" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AppManager.PackagedAppsCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Modern Windows Apps" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Residue Shield -->
                            <Border Grid.Column="3" Style="{StaticResource PilgrimCardStyle}" Margin="8,0,0,0" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="RESIDUE SHIELD" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Text="Active Guard" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimEmerald}" />
                                    <TextBlock Text="Deep AppData Cleaner" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Filter, Search & Sort Bar -->
                    <Border Grid.Row="1" Margin="28,0,28,12" Background="#0C1522" BorderBrush="#16273C" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Box -->
                            <Border Grid.Column="0" Background="#070C14" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Search24" FontSize="15" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#FFFFFF"
                                             FontSize="13.5"
                                             CaretBrush="#00E5FF"
                                             Text="{Binding AppManager.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Category Filter Pills -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <RadioButton Content="All Software"
                                             Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding AppManager.SelectedCategoryFilter, Converter={StaticResource StringToBool}, ConverterParameter=All}"
                                             Margin="0,0,8,0"
                                             Padding="12,5"
                                             FontSize="13.5" />
                                <RadioButton Content="Win32 Desktop"
                                             Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding AppManager.SelectedCategoryFilter, Converter={StaticResource StringToBool}, ConverterParameter=Win32 Desktop}"
                                             Margin="0,0,8,0"
                                             Padding="12,5"
                                             FontSize="13.5" />
                                <RadioButton Content="Store Packages"
                                             Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding AppManager.SelectedCategoryFilter, Converter={StaticResource StringToBool}, ConverterParameter=Windows Store App}"
                                             Padding="12,5"
                                             FontSize="13.5" />
                            </StackPanel>

                            <!-- Sort Options -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sort by:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <RadioButton Content="Name"
                                             Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding AppManager.SelectedSortOption, Converter={StaticResource StringToBool}, ConverterParameter=Name}"
                                             Margin="0,0,4,0"
                                             Padding="8,4"
                                             FontSize="13" />
                                <RadioButton Content="Size"
                                             Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding AppManager.SelectedSortOption, Converter={StaticResource StringToBool}, ConverterParameter=Size}"
                                             Margin="0,0,4,0"
                                             Padding="8,4"
                                             FontSize="13" />
                                <RadioButton Content="Date"
                                             Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding AppManager.SelectedSortOption, Converter={StaticResource StringToBool}, ConverterParameter=Date}"
                                             Padding="8,4"
                                             FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Applications List / Skeleton Shimmer -->
                    <Grid Grid.Row="2" Margin="28,0,28,12">
                        <!-- Skeleton / Loading Indicator -->
                        <Border Visibility="{Binding AppManager.IsLoading, Converter={StaticResource BoolToVis}}"
                                Background="#0B1320"
                                BorderBrush="#16273C"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="30">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,0,0,16" />
                                <TextBlock Text="Auditing 64-bit / 32-bit Windows Registry &amp; Microsoft Store Packages..."
                                           FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <TextBlock Text="Inspecting uninstall strings, display icons, sizes, and installation manifests."
                                           FontSize="13.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Virtualized Applications List -->
                        <ScrollViewer Visibility="{Binding AppManager.IsLoading, Converter={StaticResource InvertedBoolToVis}}"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AppManager.FilteredApplications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0C1522"
                                                BorderBrush="#17283E"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="14,10"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- App Icon / Fallback Glyph -->
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="#111F31" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Apps24" FontSize="16" Foreground="{StaticResource BrushPilgrimCyan}" />
                                                </Border>

                                                <!-- App Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="Bold" FontSize="14.5" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="450" />
                                                        <Border Background="#16273C" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayVersion, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Publisher, Mode=OneWay}" FontSize="13" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                                        <TextBlock Text=" • " FontSize="13" Foreground="#334155" Margin="4,0" />
                                                        <TextBlock Text="Installed: " FontSize="12.5" Foreground="#475569" />
                                                        <TextBlock Text="{Binding InstallDate, Mode=OneWay}" FontSize="12.5" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Category Badge -->
                                                <Border Grid.Column="2" Background="#0F1F31" BorderBrush="#1C3550" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Category, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#7DD3FC" />
                                                </Border>

                                                <!-- Size Badge -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding FormattedSize, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimCyan}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="Footprint" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Quiet Uninstall (if available) -->
                                                    <Button Style="{StaticResource PilgrimSecondaryButtonStyle}"
                                                            Visibility="{Binding HasQuietUninstall, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.AppManager.QuietUninstallApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Silent Uninstall without interactive dialogs"
                                                            Padding="8,5"
                                                            Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Shield24" FontSize="14" Foreground="{StaticResource BrushPilgrimTeal}" Margin="0,0,5,0" />
                                                            <TextBlock Text="Quiet" FontSize="12.5" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Standard Uninstall -->
                                                    <Button Style="{StaticResource PilgrimSecondaryButtonStyle}"
                                                            Command="{Binding DataContext.AppManager.UninstallApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#FF6B6B" Margin="0,0,5,0" />
                                                            <TextBlock Text="Uninstall" FontSize="12.5" FontWeight="SemiBold" Foreground="#FF6B6B" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Post-Uninstall Leftovers Review Drawer -->
                    <Border Grid.Row="3"
                            Visibility="{Binding AppManager.IsLeftoverDrawerOpen, Converter={StaticResource BoolToVis}}"
                            Background="#091422"
                            BorderBrush="#00E5FF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="28,0,28,16"
                            Padding="16,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" Color="#00E5FF" Opacity="0.4" ShadowDepth="0" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Alert24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock Text="POST-UNINSTALL LEFTOVER RESIDUE DETECTED" FontWeight="Bold" FontSize="14" Foreground="#00FF9D" />
                                </StackPanel>
                                <TextBlock Text="{Binding AppManager.FormattedLeftoverSize, Mode=OneWay, StringFormat='Total Residue: {0}'}"
                                           FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource BrushPilgrimCyan}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Folder List -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding AppManager.CurrentLeftovers}" Margin="0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#060C14" BorderBrush="#15273C" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FolderPath, Mode=OneWay}" FontSize="13" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TargetCategory, Mode=OneWay}" FontSize="11.5" Foreground="#64748B" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding FormattedSize, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimCyan}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding FileCount, Mode=OneWay, StringFormat='{}{0} files'}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Actions -->
                            <Grid Grid.Row="2">
                                <TextBlock Text="User confirmation required before purging application residue." FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Keep &amp; Dismiss"
                                            Style="{StaticResource PilgrimSecondaryButtonStyle}"
                                            Command="{Binding AppManager.DismissLeftoversCommand}"
                                            Margin="0,0,8,0"
                                            Padding="14,6"
                                            FontSize="13.5" />
                                    <Button Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                            Command="{Binding AppManager.PurgeSelectedLeftoversCommand}"
                                            Padding="16,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Broom24" FontSize="15" Margin="0,0,6,0" />
                                            <TextBlock Text="Purge Selected Residue" FontSize="13.5" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== VIEW 4: DRIVER HEALTH & WHQL AUDITOR ==================== -->
                <Grid Grid.Row="0"
                      Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Drivers}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header & Metrics -->
                    <StackPanel Grid.Row="0" Margin="28,24,28,0">
                        <Grid Margin="0,0,0,14">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Hardware Driver Health &amp; WHQL Auditor" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Complete hardware device inventory &amp; official Microsoft Windows Hardware Quality Labs (WHQL) catalog audit." FontSize="14" Foreground="#94A3B8" Margin="34,2,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource PilgrimSecondaryButtonStyle}"
                                        Command="{Binding DriverHealth.ScanDriversCommand}"
                                        Margin="0,0,8,0"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Rescan Hardware" FontWeight="SemiBold" FontSize="13.5" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                        Command="{Binding DriverHealth.CheckWhqlUpdatesCommand}"
                                        Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="CloudSync24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Check Microsoft WHQL" FontWeight="Bold" FontSize="13.5" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Strict Safety Policy Banner -->
                        <Border Background="#091726" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="STRICT SAFETY POLICY: ZERO SHADY THIRD-PARTY REPOSITORIES" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" />
                                    <TextBlock Text="Audits connect exclusively via the native Microsoft Windows Update Session (WUApiLib) and WMI. 100% verified digital signatures." FontSize="12.5" Foreground="#94A3B8" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="#11243A" BorderBrush="#00FF9D" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="OFFICIAL WHQL ONLY" FontSize="11.5" FontWeight="Bold" Foreground="#00FF9D" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Stat Cards Grid -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Total Devices -->
                            <Border Grid.Column="0" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,8,0" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="HARDWARE DEVICES" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DriverHealth.TotalDriversCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Connected Devices" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Up to Date Devices -->
                            <Border Grid.Column="1" Style="{StaticResource PilgrimCardStyle}" Margin="4,0,4,0" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="UP TO DATE" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DriverHealth.UpToDateCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimEmerald}" />
                                    <TextBlock Text="Latest Version Installed" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Signers -->
                            <Border Grid.Column="2" Style="{StaticResource PilgrimCardStyle}" Margin="4,0,4,0" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Certificate24" Foreground="{StaticResource BrushPilgrimTeal}" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="VERIFIED SIGNERS" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DriverHealth.WhqlCertifiedCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding DriverHealth.WhqlComplianceRate, Mode=OneWay, StringFormat='{}{0}% WHQL Compliance'}" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Updates Pending -->
                            <Border Grid.Column="3" Style="{StaticResource PilgrimCardStyle}" Margin="8,0,0,0" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="CloudSync24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="WHQL UPDATES" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DriverHealth.AvailableUpdates.Count, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimCyan}" />
                                    <TextBlock Text="{Binding DriverHealth.OutdatedCount, Mode=OneWay, StringFormat='{}{0} Outdated Devices'}" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Category Pills & Search -->
                    <Border Grid.Row="1" Margin="28,0,28,12" Background="#0C1522" BorderBrush="#16273C" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Search -->
                            <Border Grid.Column="0" Background="#070C14" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Search24" FontSize="15" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#FFFFFF"
                                             FontSize="13.5"
                                             CaretBrush="#00E5FF"
                                             Text="{Binding DriverHealth.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Category Filters -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <RadioButton Content="All Devices"
                                             Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding DriverHealth.SelectedCategoryFilter, Converter={StaticResource StringToBool}, ConverterParameter=All}"
                                             Margin="0,0,6,0"
                                             Padding="10,5"
                                             FontSize="13" />
                                <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding DriverHealth.SelectedCategoryFilter, Converter={StaticResource StringToBool}, ConverterParameter=Graphics}"
                                             Margin="0,0,6,0"
                                             Padding="10,5"
                                             FontSize="13">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Desktop24" FontSize="13.5" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding DriverHealth.GraphicsCount, Mode=OneWay, StringFormat='Graphics ({0})'}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding DriverHealth.SelectedCategoryFilter, Converter={StaticResource StringToBool}, ConverterParameter=Audio}"
                                             Margin="0,0,6,0"
                                             Padding="10,5"
                                             FontSize="13">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Speaker224" FontSize="13.5" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding DriverHealth.AudioCount, Mode=OneWay, StringFormat='Audio ({0})'}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding DriverHealth.SelectedCategoryFilter, Converter={StaticResource StringToBool}, ConverterParameter=Network}"
                                             Margin="0,0,6,0"
                                             Padding="10,5"
                                             FontSize="13">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Wifi124" FontSize="13.5" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding DriverHealth.NetworkCount, Mode=OneWay, StringFormat='Network ({0})'}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding DriverHealth.SelectedCategoryFilter, Converter={StaticResource StringToBool}, ConverterParameter=Storage}"
                                             Margin="0,0,6,0"
                                             Padding="10,5"
                                             FontSize="13">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="13.5" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding DriverHealth.StorageCount, Mode=OneWay, StringFormat='Storage ({0})'}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                             IsChecked="{Binding DriverHealth.SelectedCategoryFilter, Converter={StaticResource StringToBool}, ConverterParameter=System}"
                                             Padding="10,5"
                                             FontSize="13">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="13.5" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding DriverHealth.SystemCount, Mode=OneWay, StringFormat='System ({0})'}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Drivers List & Pending WHQL Updates -->
                    <ScrollViewer Grid.Row="2" Margin="28,0,28,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Pending WHQL Updates Section (if any found) -->
                            <Border Visibility="{Binding DriverHealth.HasAvailableUpdates, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource PilgrimCardStyle}"
                                    BorderBrush="#00E5FF"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CloudSync24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="20" Margin="0,0,10,0" />
                                            <TextBlock Text="OFFICIAL MICROSOFT WHQL DRIVER PACKAGES DISCOVERED" FontWeight="Bold" FontSize="14" Foreground="#00E5FF" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="#122A42" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                                <TextBlock Text="NATIVE WINDOWS UPDATE" FontWeight="Bold" FontSize="12" Foreground="#00E5FF" />
                                            </Border>
                                            <Button Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                                    Command="{Binding DriverHealth.InstallAllUpdatesCommand}"
                                                    IsEnabled="{Binding DriverHealth.IsInstallingAnyUpdate, Converter={StaticResource InvertedBoolToVis}}"
                                                    Padding="12,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="CloudSync24" FontSize="14" Margin="0,0,5,0" />
                                                    <TextBlock Text="Install All WHQL Updates" FontWeight="Bold" FontSize="13" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding DriverHealth.AvailableUpdates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0B1522" BorderBrush="#1B314B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                                            <TextBlock Text="{Binding Description, Mode=OneWay}" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="Provider: " FontSize="12" Foreground="#64748B" />
                                                                <TextBlock Text="{Binding DriverProvider, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#00E5FF" Margin="0,0,10,0" />
                                                                <TextBlock Text="Model: " FontSize="12" Foreground="#64748B" />
                                                                <TextBlock Text="{Binding DriverModel, Mode=OneWay}" FontSize="12" Foreground="#E2E8F0" Margin="0,0,10,0" />
                                                                <TextBlock Text="Date: " FontSize="12" Foreground="#64748B" />
                                                                <TextBlock Text="{Binding DriverVerDate, Mode=OneWay}" FontSize="12" Foreground="#94A3B8" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#0F2820" BorderBrush="#00FF9D" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="Checkmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="13.5" Margin="0,0,4,0" />
                                                                    <TextBlock Text="WHQL Certified" FontWeight="Bold" FontSize="12" Foreground="#00FF9D" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Direct Install Button -->
                                                            <Button Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                                                    Command="{Binding DataContext.DriverHealth.InstallUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding IsInstalling, Converter={StaticResource InvertedBoolToVis}}"
                                                                    Padding="12,5">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="CloudSync24" FontSize="13.5" Margin="0,0,5,0" />
                                                                    <TextBlock Text="{Binding InstallStatus, Mode=OneWay, FallbackValue='Install WHQL Driver'}" FontSize="12.5" FontWeight="Bold" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Loading Skeleton -->
                            <Border Visibility="{Binding DriverHealth.IsScanningDrivers, Converter={StaticResource BoolToVis}}"
                                    Background="#0B1320"
                                    BorderBrush="#16273C"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="30"
                                    Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,0,0,16" />
                                    <TextBlock Text="Querying Hardware Devices &amp; WHQL Digital Signatures..."
                                               FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Scanning Win32_PnPSignedDriver catalog across Graphics, Audio, Network, Storage, and System buses."
                                               FontSize="13.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Drivers Virtualized Items -->
                            <ItemsControl ItemsSource="{Binding DriverHealth.FilteredDrivers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0C1522"
                                                BorderBrush="#17283E"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="14,10"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="135" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Device Category Icon -->
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="#111F31" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="{Binding CategoryIcon, Mode=OneWay}" FontSize="16" Foreground="{StaticResource BrushPilgrimCyan}" />
                                                </Border>

                                                <!-- Device & Driver Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                                    <TextBlock Text="{Binding DeviceName, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="Version: " FontSize="12.5" Foreground="#475569" />
                                                        <TextBlock Text="{Binding DriverVersion, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                        <TextBlock Text=" • " FontSize="12.5" Foreground="#334155" Margin="4,0" />
                                                        <TextBlock Text="Date: " FontSize="12.5" Foreground="#475569" />
                                                        <TextBlock Text="{Binding DriverDate, Mode=OneWay}" FontSize="12.5" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Device Class -->
                                                <Border Grid.Column="2" Background="#0F1F31" BorderBrush="#1C3550" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding DeviceClass, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#7DD3FC" />
                                                </Border>

                                                <!-- Signer -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Signer, Mode=OneWay}" FontSize="12.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                                    <TextBlock Text="Digital Signer" FontSize="11" Foreground="#64748B" />
                                                </StackPanel>

                                                <!-- Up-To-Date vs Update Action Badge -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Up to Date Badge -->
                                                    <Border Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVis}}"
                                                            Background="#0B231A" BorderBrush="#00FF9D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="14" Margin="0,0,5,0" />
                                                            <TextBlock Text="Up to Date" FontWeight="Bold" FontSize="12" Foreground="#00FF9D" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Outdated / Update Available Badge & Button -->
                                                    <StackPanel Visibility="{Binding HasPendingUpdate, Converter={StaticResource BoolToVis}}" Orientation="Horizontal">
                                                        <Border Background="#122538" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="13.5" Margin="0,0,4,0" />
                                                                <TextBlock Text="New Version" FontWeight="Bold" FontSize="12" Foreground="#00E5FF" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Button Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                                                Command="{Binding DataContext.DriverHealth.InstallDriverUpdateFromDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="10,5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="CloudSync24" FontSize="13.5" Margin="0,0,4,0" />
                                                                <TextBlock Text="Install" FontSize="12" FontWeight="Bold" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== VIEW: SPACE LENS (LARGE & OLD FILES) ==================== -->
                <Grid Grid.Row="0" Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=SpaceLens}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,24,28,0">
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentSearch24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Space Lens: Large &amp; Ancient Files" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Visual discovery and audit of large archives, media files, and ancient downloads occupying your drives." FontSize="14" Foreground="#94A3B8" Margin="34,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource PilgrimSecondaryButtonStyle}" Command="{Binding SpaceLens.SelectAllFilteredCommand}" Margin="0,0,8,0" Padding="12,7">
                                    <TextBlock Text="Select All" />
                                </Button>
                                <Button Style="{StaticResource PilgrimSecondaryButtonStyle}" Command="{Binding SpaceLens.DeselectAllCommand}" Margin="0,0,8,0" Padding="12,7">
                                    <TextBlock Text="Deselect All" />
                                </Button>
                                <Button Style="{StaticResource PilgrimPrimaryButtonStyle}" Command="{Binding SpaceLens.StartScanCommand}" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Scan Libraries" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,8,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="LARGE FILES" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SpaceLens.TotalFilesFound, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                    <TextBlock Text="Over 50 MB threshold" FontSize="12.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PilgrimCardStyle}" Margin="4,0,4,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="TOTAL VOLUME" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SpaceLens.TotalVolumeText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,4,0,0" />
                                    <TextBlock Text="Cataloged in libraries" FontSize="12.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PilgrimCardStyle}" Margin="4,0,4,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="SELECTED TARGETS" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SpaceLens.SelectedFilesCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SpaceLens.SelectedVolumeText, Mode=OneWay, StringFormat='{}Volume: {0}'}" FontSize="12.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource PilgrimCardStyle}" Margin="8,0,0,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="RECYCLE BIN ACTION" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <Button Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                            Command="{Binding SpaceLens.DeleteSelectedToRecycleBinCommand}"
                                            Background="#991B1B"
                                            Margin="0,6,0,0"
                                            Padding="10,6">
                                        <TextBlock Text="Recycle Selected" FontSize="13" Foreground="#FFFFFF" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="28,0,28,12" Background="#0C1522" BorderBrush="#16273C" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#070C14" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Search24" FontSize="15" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="13.5" CaretBrush="#00E5FF"
                                             Text="{Binding SpaceLens.SearchQuery, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Size: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <RadioButton Content="All Sizes" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding SpaceLens.SelectedSizeFilter, Converter={StaticResource StringToBool}, ConverterParameter='All Sizes'}" Margin="0,0,4,0" Padding="8,4" FontSize="12.5" />
                                <RadioButton Content="Huge (&gt; 2 GB)" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding SpaceLens.SelectedSizeFilter, Converter={StaticResource StringToBool}, ConverterParameter='Huge (&gt; 2 GB)'}" Margin="0,0,4,0" Padding="8,4" FontSize="12.5" />
                                <RadioButton Content="Very Large" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding SpaceLens.SelectedSizeFilter, Converter={StaticResource StringToBool}, ConverterParameter='Very Large (500 MB - 2 GB)'}" Margin="0,0,12,0" Padding="8,4" FontSize="12.5" />

                                <TextBlock Text="Age: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <RadioButton Content="All Ages" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding SpaceLens.SelectedAgeFilter, Converter={StaticResource StringToBool}, ConverterParameter='All Ages'}" Margin="0,0,4,0" Padding="8,4" FontSize="12.5" />
                                <RadioButton Content="Ancient (&gt; 1 Yr)" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding SpaceLens.SelectedAgeFilter, Converter={StaticResource StringToBool}, ConverterParameter='Ancient (&gt; 1 Year)'}" Margin="0,0,4,0" Padding="8,4" FontSize="12.5" />
                                <RadioButton Content="Old (&gt; 6 Mo)" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding SpaceLens.SelectedAgeFilter, Converter={StaticResource StringToBool}, ConverterParameter='Old (6 - 12 Months)'}" Padding="8,4" FontSize="12.5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" Margin="28,0,28,12" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SpaceLens.FilteredItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0C1522" BorderBrush="#17283E" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="6" Background="#111F31" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="{Binding CategoryIcon}" FontSize="15" Foreground="{StaticResource BrushPilgrimCyan}" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,12,0">
                                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                                <TextBlock Text="{Binding DirectoryName}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                            </StackPanel>
                                            <Border Grid.Column="3" Background="#14263C" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AgeCategory}" FontSize="12" Foreground="#94A3B8" />
                                            </Border>
                                            <TextBlock Grid.Column="4" Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPilgrimCyan}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />
                                            <Button Grid.Column="5" Style="{StaticResource PilgrimSecondaryButtonStyle}"
                                                    Command="{Binding DataContext.SpaceLens.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="13.5" Margin="0,0,4,0" />
                                                    <TextBlock Text="Reveal" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== VIEW: DUPLICATES FINDER ==================== -->
                <Grid Grid.Row="0" Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Duplicates}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,24,28,14">
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Duplicate &amp; Redundant Files" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Two-tier cryptographic SHA-256 analysis identifying exact byte-for-byte duplicate copies." FontSize="14" Foreground="#94A3B8" Margin="34,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource PilgrimSecondaryButtonStyle}" Command="{Binding Duplicates.SelectAllRedundantCommand}" Margin="0,0,8,0" Padding="12,7">
                                    <TextBlock Text="Smart Select (Duplicates)" />
                                </Button>
                                <Button Style="{StaticResource PilgrimSecondaryButtonStyle}" Command="{Binding Duplicates.DeselectAllCommand}" Margin="0,0,8,0" Padding="12,7">
                                    <TextBlock Text="Deselect All" />
                                </Button>
                                <Button Style="{StaticResource PilgrimPrimaryButtonStyle}" Command="{Binding Duplicates.StartScanCommand}" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Scan Duplicates" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,8,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="DUPLICATE GROUPS" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Duplicates.TotalDuplicateGroups, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                    <TextBlock Text="Identical clusters" FontSize="12.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PilgrimCardStyle}" Margin="4,0,4,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="REDUNDANT COPIES" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Duplicates.TotalRedundantFiles, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,4,0,0" />
                                    <TextBlock Text="Files taking excess space" FontSize="12.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PilgrimCardStyle}" Margin="4,0,4,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="WASTED STORAGE" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Duplicates.WastedVolumeText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimEmerald}" Margin="0,4,0,0" />
                                    <TextBlock Text="Recoverable disk space" FontSize="12.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource PilgrimCardStyle}" Margin="8,0,0,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="PURGE ACTION" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <Button Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                            Command="{Binding Duplicates.DeleteSelectedCopiesCommand}"
                                            Background="#991B1B"
                                            Margin="0,6,0,0"
                                            Padding="10,6">
                                        <TextBlock Text="Recycle Selected Copies" FontSize="13" Foreground="#FFFFFF" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="28,0,28,12" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Duplicates.DuplicateGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0C1522" BorderBrush="#1C2E46" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="DocumentCopy24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="20" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding SampleFileName}" FontWeight="Bold" FontSize="14.5" Foreground="#FFFFFF" />
                                                    <Border Background="#14263C" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Copies.Count, StringFormat='{}{0} Copies'}" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" />
                                                    </Border>
                                                    <Border Background="#0C2419" BorderBrush="#00FF9D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="SHA-256 Byte-Identical" FontSize="11" FontWeight="Bold" Foreground="#00FF9D" />
                                                    </Border>
                                                    <Border Background="#101C2B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding FormattedSize, StringFormat='{}File Size: {0}'}" FontSize="11.5" Foreground="#94A3B8" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock HorizontalAlignment="Right" Text="{Binding FormattedWastedBytes, StringFormat='Wasted: {0}'}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPilgrimEmerald}" VerticalAlignment="Center" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Copies}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#070D16" BorderBrush="#142132" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" IsEnabled="{Binding IsOriginal, Converter={StaticResource InvertedBool}}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding FullPath}" FontSize="12.5" Foreground="#CBD5E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" ToolTip="{Binding FullPath}" />
                                                                <Border Grid.Column="2" Visibility="{Binding IsOriginal, Converter={StaticResource BoolToVis}}" Background="#0E2B1E" BorderBrush="#00FF9D" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="Original (Keep)" FontSize="11" FontWeight="Bold" Foreground="#00FF9D" />
                                                                </Border>
                                                                <Border Grid.Column="2" Visibility="{Binding IsOriginal, Converter={StaticResource InvertedBoolToVis}}" Background="#122436" CornerRadius="4" Padding="6,1.5" Margin="8,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="Redundant Copy" FontSize="11" Foreground="#38BDF8" />
                                                                </Border>
                                                                <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="4" Text="{Binding FormattedDate}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== VIEW: STARTUP & BOOT ACCELERATOR ==================== -->
                <Grid Grid.Row="0" Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Startup}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,24,28,0">
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Flash24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Startup Boot Accelerator" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Safely accelerate Windows boot times via native StartupApproved bitmasks. Zero registry key deletions." FontSize="14" Foreground="#94A3B8" Margin="34,2,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource PilgrimPrimaryButtonStyle}" Command="{Binding Startup.RefreshStartupItemsCommand}" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Rescan Startup" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,8,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="TOTAL STARTUP APPS" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Startup.TotalCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                    <TextBlock Text="Registered boot entries" FontSize="12.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PilgrimCardStyle}" Margin="4,0,4,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE AT BOOT" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Startup.EnabledCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,4,0,0" />
                                    <TextBlock Text="Programs auto-launching" FontSize="12.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PilgrimCardStyle}" Margin="8,0,0,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="HIGH BOOT IMPACT" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Startup.HighImpactCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#FF4D4D" Margin="0,4,0,0" />
                                    <TextBlock Text="Heavy CPU/disk delays" FontSize="12.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="28,0,28,12" Background="#0C1522" BorderBrush="#16273C" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#070C14" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Search24" FontSize="15" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="13.5" CaretBrush="#00E5FF"
                                             Text="{Binding Startup.SearchQuery, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <RadioButton Content="All Entries" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding Startup.SelectedFilter, Converter={StaticResource StringToBool}, ConverterParameter='All'}" Margin="0,0,6,0" Padding="10,5" FontSize="13" />
                                <RadioButton Content="Enabled Only" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding Startup.SelectedFilter, Converter={StaticResource StringToBool}, ConverterParameter='Enabled'}" Margin="0,0,6,0" Padding="10,5" FontSize="13" />
                                <RadioButton Content="Disabled Only" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding Startup.SelectedFilter, Converter={StaticResource StringToBool}, ConverterParameter='Disabled'}" Margin="0,0,6,0" Padding="10,5" FontSize="13" />
                                <RadioButton Content="High Impact" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding Startup.SelectedFilter, Converter={StaticResource StringToBool}, ConverterParameter='High Impact'}" Padding="10,5" FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" Margin="28,0,28,12" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Startup.FilteredItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0C1522" BorderBrush="#17283E" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#111F31" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="{Binding SourceIcon}" FontSize="15" Foreground="{StaticResource BrushPilgrimCyan}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                                <TextBlock Text="{Binding Publisher}" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Command}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#122336" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceType}" FontSize="11.5" Foreground="#7DD3FC" />
                                            </Border>
                                            <Border Grid.Column="3" Background="#141E2D" CornerRadius="4" Padding="8,3" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StartupImpact, StringFormat='{}Impact: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{Binding ImpactBadgeColor}" HorizontalAlignment="Center" />
                                            </Border>
                                            <ui:ToggleSwitch Grid.Column="4" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                             Command="{Binding DataContext.Startup.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding}"
                                                             VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== VIEW: SYSTEM VITALS & TELEMETRY ==================== -->
                <Grid Grid.Row="0" Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Telemetry}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,24,28,16">
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Heart24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Hardware Telemetry &amp; Battery Health" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Real-time monitoring of CPU load, RAM allocation, and laptop battery wear. Zero RAM flushing hacks." FontSize="14" Foreground="#94A3B8" Margin="34,2,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource PilgrimSecondaryButtonStyle}" Command="{Binding Telemetry.ToggleMonitoringCommand}" Padding="16,8">
                                <TextBlock Text="{Binding Telemetry.StatusMessage}" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- CPU -->
                            <Border Grid.Column="0" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,6,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="PROCESSOR (CPU)" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.CpuUsagePercent, Mode=OneWay, StringFormat='{}{0:N1}%'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,2,0,0" />
                                    <ProgressBar Value="{Binding Telemetry.Telemetry.CpuUsagePercent, Mode=OneWay}" Height="5" Foreground="{StaticResource BrushPilgrimCyan}" Background="#18273A" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.CpuName, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.CpuCoresDescription, Mode=OneWay}" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.ProcessCount, Mode=OneWay, StringFormat='{}{0} Active Processes'}" FontSize="11.5" Foreground="#38BDF8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <!-- RAM -->
                            <Border Grid.Column="1" Style="{StaticResource PilgrimCardStyle}" Margin="3,0,3,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="MEMORY (RAM)" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.RamUsagePercent, Mode=OneWay, StringFormat='{}{0}%'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushPilgrimEmerald}" Margin="0,2,0,0" />
                                    <ProgressBar Value="{Binding Telemetry.Telemetry.RamUsagePercent, Mode=OneWay}" Height="5" Foreground="{StaticResource BrushPilgrimEmerald}" Background="#18273A" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.FormattedRamUsed, Mode=OneWay, StringFormat='{}In Use: {0}'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.FormattedRamTotal, Mode=OneWay, StringFormat='{}Total Installed: {0}'}" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.FormattedRamAvailable, Mode=OneWay, StringFormat='{}Available: {0}'}" FontSize="11.5" Foreground="#34D399" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <!-- GPU -->
                            <Border Grid.Column="2" Style="{StaticResource PilgrimCardStyle}" Margin="3,0,3,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="GRAPHICS (GPU)" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.GpuName, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.FormattedGpuVram, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.GpuDriverVersion, Mode=OneWay}" FontSize="11.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    <TextBlock Text="DirectX 12 / D3D12 Ready" FontSize="11.5" Foreground="#A78BFA" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <!-- OS & Uptime -->
                            <Border Grid.Column="3" Style="{StaticResource PilgrimCardStyle}" Margin="6,0,0,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="OS &amp; SYSTEM UPTIME" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.SystemUptimeText, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.OsVersionText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.CpuArchitecture, Mode=OneWay}" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Telemetry.Telemetry.MachineName, Mode=OneWay, StringFormat='{}Host: {0}'}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="28,0,28,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Storage Volumes Section -->
                            <Border Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="LOGICAL DISK VOLUMES &amp; PARTITIONS" FontWeight="Bold" FontSize="14" Foreground="#00E5FF" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding Telemetry.Telemetry.Drives}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#070C15" BorderBrush="#16273C" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#111F31" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <ui:SymbolIcon Symbol="Storage24" FontSize="20" Foreground="{StaticResource BrushPilgrimCyan}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" FontSize="14.5" Foreground="#FFFFFF" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding VolumeLabel, StringFormat='({0})'}" FontSize="13.5" Foreground="#94A3B8" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding FileSystem, StringFormat='{}File System: {0}'}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,20,0">
                                                            <Grid Margin="0,0,0,4">
                                                                <TextBlock Text="{Binding UsagePercent, StringFormat='{}{0:N1}% Used'}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#94A3B8">
                                                                    <Run Text="{Binding FormattedUsed, Mode=OneWay}" />
                                                                    <Run Text=" / " />
                                                                    <Run Text="{Binding FormattedTotal, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Grid>
                                                            <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Height="7" Background="#18273A" Foreground="{StaticResource BrushPilgrimCyan}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="3" Background="#11243A" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FormattedFree, StringFormat='{}{0} Free'}" FontWeight="Bold" FontSize="12.5" Foreground="#34D399" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Battery & Power Section -->
                            <Border Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#122538" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <ui:SymbolIcon Symbol="BatteryCharge24" FontSize="20" Foreground="{StaticResource BrushPilgrimEmerald}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="POWER SOURCE &amp; BATTERY STATUS" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding Telemetry.Telemetry.BatteryStatus}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Telemetry.Telemetry.BatteryHealthVerdict}" FontSize="13" Foreground="{StaticResource BrushPilgrimEmerald}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#0C1B2B" CornerRadius="6" Padding="14,8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Telemetry.Telemetry.BatteryPercent, StringFormat='{}{0}% Charge'}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushPilgrimCyan}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Enterprise Manifesto Card -->
                            <Border Style="{StaticResource PilgrimCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="ENTERPRISE MEMORY &amp; PROCESSOR INTEGRITY" FontWeight="Bold" FontSize="14" Foreground="#00E5FF" Margin="0,0,0,10" />
                                    <TextBlock Text="Pilgrim Cleaner adheres to the Windows kernel architecture manifesto: memory flushing hacks are strictly disabled. Windows dynamically manages standby cache to accelerate disk reads. Telemetry provides authentic real-time metrics without thrashing page files." FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== VIEW: PRIVACY SHIELD ==================== -->
                <Grid Grid.Row="0" Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Privacy}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,24,28,16">
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Shield24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Privacy &amp; Footprint Shield" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Eradicate activity traces across Windows Recent Documents, Taskbar Jump Lists, and Clipboard history." FontSize="14" Foreground="#94A3B8" Margin="34,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource PilgrimSecondaryButtonStyle}" Command="{Binding Privacy.SelectAllCommand}" Margin="0,0,8,0" Padding="12,7">
                                    <TextBlock Text="Select All" />
                                </Button>
                                <Button Style="{StaticResource PilgrimPrimaryButtonStyle}" Command="{Binding Privacy.PurgePrivacyCommand}" Background="{StaticResource BrushPilgrimGlowButton}" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Purge Selected Traces" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PRIVACY INTEGRITY STATUS" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Privacy.StatusMessage}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#122538" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Privacy.TotalTraceItems, StringFormat='{}{0} Traces Found'}" FontWeight="Bold" FontSize="14" Foreground="#00E5FF" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="28,0,28,12" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Privacy.Targets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0C1522" BorderBrush="#17283E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="6" Background="#111F31" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="15" Foreground="{StaticResource BrushPilgrimCyan}" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,12,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14.5" Foreground="#FFFFFF" />
                                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="3" Background="#14263C" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#7DD3FC" />
                                                </Border>
                                                <Border Grid.Column="4" Background="#16273C" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} items'}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource BrushPilgrimCyan}" />
                                                </Border>
                                                <Button Grid.Column="5" Style="{StaticResource PilgrimSecondaryButtonStyle}"
                                                        Command="{Binding DataContext.Privacy.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="10,4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Eye24" FontSize="14" Margin="0,0,4,0" />
                                                        <TextBlock Text="Inspect Traces" FontSize="12.5" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Expanded Trace Items Viewer -->
                                            <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                    Background="#060C14" BorderBrush="#182A3E" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="DISCOVERED PRIVACY TRACES &amp; ARTIFACTS" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
                                                    <ItemsControl ItemsSource="{Binding DiscoveredTraces}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#09121D" BorderBrush="#132337" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ui:SymbolIcon Grid.Column="0" Symbol="DocumentBulletList16" FontSize="14" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedTime}" FontSize="12" Foreground="#94A3B8" Margin="12,0" VerticalAlignment="Center" />
                                                                        <Border Grid.Column="3" Background="#11243A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FormattedSize}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== VIEW: AUTOMATION & SCHEDULER ==================== -->
                <Grid Grid.Row="0" Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Scheduler}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,24,28,16">
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Timer24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Automated Background Maintenance" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Configure weekly headless maintenance routines via Windows Task Scheduler with native Windows 11 Toasts." FontSize="14" Foreground="#94A3B8" Margin="34,2,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource PilgrimSecondaryButtonStyle}" Command="{Binding Scheduler.SendTestToastCommand}" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Alert24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Test Toast Notification" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource PilgrimCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="AUTOMATED BACKGROUND MAINTENANCE" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Scheduler.TaskInfo.ScheduleDetails, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Scheduler.StatusMessage}" FontSize="13.5" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,4,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Scheduler.IsScheduleActive, Mode=OneWay}"
                                                 Command="{Binding Scheduler.ToggleScheduleCommand}"
                                                 VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="28,0,28,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Live Task Verification Grid (Answers: How do I know it runs?) -->
                            <Border Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="WINDOWS TASK SCHEDULER VERIFICATION TELEMETRY" FontWeight="Bold" FontSize="12.5" Foreground="#00E5FF" />
                                        <Button HorizontalAlignment="Right" Style="{StaticResource PilgrimSecondaryButtonStyle}" Command="{Binding Scheduler.RefreshStatusCommand}" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="13.5" Margin="0,0,4,0" />
                                                <TextBlock Text="Refresh Status" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Next Run Time -->
                                        <Border Grid.Column="0" Background="#070C15" BorderBrush="#16273C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="NEXT SCHEDULED RUN" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                                <TextBlock Text="{Binding Scheduler.TaskInfo.NextRunTime, Mode=OneWay}" FontSize="14.5" FontWeight="Bold" Foreground="#00E5FF" Margin="0,4,0,0" />
                                                <TextBlock Text="Exact OS Trigger Time" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Task Status -->
                                        <Border Grid.Column="1" Background="#070C15" BorderBrush="#16273C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="TASK STATE" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                                <TextBlock Text="{Binding Scheduler.TaskInfo.Status, Mode=OneWay}" FontSize="14.5" FontWeight="Bold" Foreground="#00FF9D" Margin="0,4,0,0" />
                                                <TextBlock Text="Windows Task Engine" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Last Run Time -->
                                        <Border Grid.Column="2" Background="#070C15" BorderBrush="#16273C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="LAST EXECUTION" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                                <TextBlock Text="{Binding Scheduler.TaskInfo.LastRunTime, Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Scheduler.TaskInfo.LastResult, StringFormat='Result Code: {0}'}" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <!-- OS Task Path -->
                                        <Border Grid.Column="3" Background="#070C15" BorderBrush="#16273C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="OS TASK NAME" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                                <TextBlock Text="{Binding Scheduler.TaskInfo.TaskPath, Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                                <TextBlock Text="Arguments: --silent-audit" FontSize="11.5" Foreground="#38BDF8" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Quick Verification Action Buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Style="{StaticResource PilgrimPrimaryButtonStyle}" Command="{Binding Scheduler.RunTaskNowCommand}" Padding="14,7" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Flash24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Trigger Task Now (Test Execution)" FontWeight="Bold" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PilgrimSecondaryButtonStyle}" Command="{Binding Scheduler.OpenTaskSchedulerCommand}" Padding="14,7">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Inspect in Windows Task Scheduler (taskschd.msc)" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Custom Date, Day & Time Configuration Panel -->
                            <Border Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CUSTOMIZE SCHEDULE (FREQUENCY, DAY &amp; TIME)" FontWeight="Bold" FontSize="12.5" Foreground="#00E5FF" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Frequency Selection -->
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Frequency" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding Scheduler.SelectedFrequency, Mode=TwoWay}"
                                                      Background="#091322" Foreground="#FFFFFF" BorderBrush="#1C2F46" Padding="10,6">
                                                <ComboBoxItem Content="Weekly" IsSelected="True" />
                                                <ComboBoxItem Content="Daily" />
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Day of Week Selection -->
                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Day of Week" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding Scheduler.SelectedDay, Mode=TwoWay}"
                                                      Background="#091322" Foreground="#FFFFFF" BorderBrush="#1C2F46" Padding="10,6">
                                                <ComboBoxItem Content="Sunday" IsSelected="True" />
                                                <ComboBoxItem Content="Monday" />
                                                <ComboBoxItem Content="Tuesday" />
                                                <ComboBoxItem Content="Wednesday" />
                                                <ComboBoxItem Content="Thursday" />
                                                <ComboBoxItem Content="Friday" />
                                                <ComboBoxItem Content="Saturday" />
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Time of Day Selection -->
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="Execution Time" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Scheduler.SelectedTime, Mode=TwoWay}"
                                                      Background="#091322" Foreground="#FFFFFF" BorderBrush="#1C2F46" Padding="10,6">
                                                <ComboBoxItem Content="02:00 AM (Overnight - Recommended)" Tag="02:00" IsSelected="True" />
                                                <ComboBoxItem Content="06:00 AM (Early Morning)" Tag="06:00" />
                                                <ComboBoxItem Content="12:00 PM (Midday)" Tag="12:00" />
                                                <ComboBoxItem Content="18:00 PM (Evening)" Tag="18:00" />
                                                <ComboBoxItem Content="22:00 PM (Night)" Tag="22:00" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Alert Threshold & Save Button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Notification Storage Threshold" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                                            <TextBlock Text="Only dispatch a Windows 11 Toast notification when recoverable storage exceeds 1.0 GB." FontSize="12.5" Foreground="#94A3B8" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                                Command="{Binding Scheduler.ApplyScheduleChangesCommand}"
                                                Background="{StaticResource BrushPilgrimGlowButton}"
                                                Padding="18,8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Save24" FontSize="15" Margin="0,0,6,0" />
                                                <TextBlock Text="Save &amp; Apply Schedule" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Architecture Manifesto Card -->
                            <Border Style="{StaticResource PilgrimCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="HOW WINDOWS TASK SCHEDULER EXECUTES SILENT AUDITS" FontWeight="Bold" FontSize="14" Foreground="#00E5FF" Margin="0,0,0,10" />
                                    <TextBlock Text="When activated, the native Windows Task Scheduler service (Schedule / schtasks.exe) invokes Pilgrim Cleaner in headless silent mode ('--silent-audit') at your chosen time. The app scans your storage targets in under 3 seconds with zero UI footprint. If junk cache exceeds your threshold, a native Windows 11 notification banner is displayed inviting you to review or purge. Zero permanent background memory or CPU usage when idle." FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== VIEW: HELP & DOCUMENTATION MANUAL ==================== -->
                <Grid Grid.Row="0" Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=Help}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="28,24,28,0">
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="QuestionCircle24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="User Manual &amp; Knowledge Base" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Comprehensive interactive manual, enterprise safety policies, and step-by-step suite documentation." FontSize="14" Foreground="#94A3B8" Margin="34,2,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#11243A" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Help.ResultsCount, StringFormat='{}{0} Chapters Available'}" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Search & Filter Bar -->
                    <Border Grid.Row="1" Margin="28,0,28,12" Background="#0C1522" BorderBrush="#16273C" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Instant Search Box -->
                            <Border Grid.Column="0" Background="#070C14" BorderBrush="#1A2D44" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Search24" FontSize="15" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="13.5" CaretBrush="#00E5FF"
                                             Text="{Binding Help.SearchQuery, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Category Filter Chips -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <RadioButton Content="All Topics" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding Help.SelectedCategory, Converter={StaticResource StringToBool}, ConverterParameter='All'}" Margin="0,0,4,0" Padding="10,5" FontSize="13" />
                                <RadioButton Content="Getting Started" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding Help.SelectedCategory, Converter={StaticResource StringToBool}, ConverterParameter='Getting Started'}" Margin="0,0,4,0" Padding="10,5" FontSize="13" />
                                <RadioButton Content="Storage &amp; Cleanup" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding Help.SelectedCategory, Converter={StaticResource StringToBool}, ConverterParameter='Storage &amp; Cleanup'}" Margin="0,0,4,0" Padding="10,5" FontSize="13" />
                                <RadioButton Content="System Management" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding Help.SelectedCategory, Converter={StaticResource StringToBool}, ConverterParameter='System Management'}" Margin="0,0,4,0" Padding="10,5" FontSize="13" />
                                <RadioButton Content="Vitals &amp; Privacy" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding Help.SelectedCategory, Converter={StaticResource StringToBool}, ConverterParameter='Vitals &amp; Privacy'}" Margin="0,0,4,0" Padding="10,5" FontSize="13" />
                                <RadioButton Content="Safety &amp; Policies" Style="{StaticResource PilgrimNavButtonStyle}" IsChecked="{Binding Help.SelectedCategory, Converter={StaticResource StringToBool}, ConverterParameter='Safety &amp; Policies'}" Padding="10,5" FontSize="13" />
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource PilgrimSecondaryButtonStyle}" Command="{Binding Help.ClearSearchCommand}" Padding="10,5">
                                <TextBlock Text="Clear Filter" FontSize="12.5" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Split Master-Detail Layout -->
                    <Grid Grid.Row="2" Margin="28,0,28,16">
                        <Grid.ColumnDefinitions>
                            <!-- Master: Topics List (320px) -->
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="16" />
                            <!-- Detail: Document Reader -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Topics List -->
                        <Border Grid.Column="0" Background="#0A111C" BorderBrush="#142234" BorderThickness="1" CornerRadius="10" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Help.FilteredArticles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource PilgrimNavButtonStyle}"
                                                         Height="Auto"
                                                         MinHeight="58"
                                                         Padding="10,8"
                                                         Margin="0,0,0,4"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         Command="{Binding DataContext.Help.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#112032" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="15" Foreground="{StaticResource BrushPilgrimCyan}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="240" Margin="0,2,0,0" />
                                                        <Border Background="#122336" CornerRadius="3" Padding="4,1" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#7DD3FC" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Document Reader View -->
                        <Border Grid.Column="2" Style="{StaticResource PilgrimCardStyle}" Padding="22,18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding Help.SelectedArticle}">
                                    <!-- Article Header -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#112238" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="24" Foreground="{StaticResource BrushPilgrimCyan}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Border Background="#14263C" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Category}" FontSize="11.5" FontWeight="Bold" Foreground="#00E5FF" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                        <!-- Quick Jump Button -->
                                        <Button Grid.Column="2" Style="{StaticResource PilgrimPrimaryButtonStyle}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding NavigationTargetView}"
                                                Padding="14,8"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Open Module" FontWeight="Bold" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Summary Callout Box -->
                                    <Border Background="#0C1B2E" BorderBrush="#1C3858" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Info24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" TextWrapping="Wrap" MaxWidth="620" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Body Text Content -->
                                    <Border Background="#080F1A" BorderBrush="#142132" BorderThickness="1" CornerRadius="8" Padding="18,16">
                                        <TextBlock Text="{Binding Content}"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                   FontSize="14"
                                                   LineHeight="22"
                                                   Foreground="#CBD5E1"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding CurrentView, Converter={StaticResource StringToVis}, ConverterParameter=About}">
                    <Grid Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Brand Presentation Card -->
                        <Border Grid.Row="0" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,20">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Stylized Glowing P Emblem (Mathematical Vector) -->
                                <ctrl:PilgrimLogoControl Grid.Column="0"
                                                         Width="128"
                                                         Height="128"
                                                         ShowSquircleBackground="True"
                                                         GlowOpacity="0.85"
                                                         Margin="0,0,24,0"
                                                         VerticalAlignment="Center">
                                    <ctrl:PilgrimLogoControl.Effect>
                                        <DropShadowEffect BlurRadius="32" Color="#00E5FF" Opacity="0.65" ShadowDepth="0" />
                                    </ctrl:PilgrimLogoControl.Effect>
                                </ctrl:PilgrimLogoControl>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Pilgrim Cleaner" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Developed by Pilgrim Software" FontSize="16" FontWeight="SemiBold" Foreground="#00E5FF" Margin="0,2,0,0" />
                                    <TextBlock Text="Windows Disk Cleaner, Application Uninstaller, Safe WHQL Driver Auditor &amp; Sysadmin CLI" FontSize="15" Foreground="#94A3B8" Margin="0,6,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border Background="#16273C" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text="Version 1.1.0" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" />
                                        </Border>
                                        <Border Background="#16273C" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text=".NET 10.0 Windows x64" FontSize="14" FontWeight="Bold" Foreground="#94A3B8" />
                                        </Border>
                                        <Border Background="#16273C" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text="Sysadmin CLI (pilgrim.exe)" FontSize="14" FontWeight="Bold" Foreground="#00FF9D" />
                                        </Border>
                                        <Border Background="#16273C" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="GNU GPLv3 Licensed" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Enterprise Safety Manifesto Card -->
                        <Border Grid.Row="1" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,20">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="ENTERPRISE SAFETY MANIFESTO &amp; SYSTEM POLICIES" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,14" />

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="1. Zero Registry Tampering" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                        <TextBlock Text="Pilgrim Cleaner never modifies, optimizes, or cleans the Windows Registry. Registry cleaners cause system degradation without measurable benefit." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,8" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="2. Zero RAM Flushing" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                        <TextBlock Text="No artificial working-set trims or memory dumping hacks that force Windows to thrash the page file." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,8" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="3. Mandatory 24-Hour Age Safety Buffer" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                        <TextBlock Text="Files created or modified within the last 24 hours in temp folders are strictly skipped to protect running software installers and active background operations." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,8" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="4. Resilient File Access" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                        <TextBlock Text="Gracefully catches and suppresses UnauthorizedAccessException and IOException for files currently locked by the OS or running applications, transparently recording them to the debug log." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,8" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="5. Mandatory Audit Preview (No Blind Deletions)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                        <TextBlock Text="Three-stage architecture: Scan &amp; Audit -&gt; Review &amp; Selection -&gt; Explicit Execution. Every byte is accounted for before purging." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,8" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="6. Native Windows Shell API Integration" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                        <TextBlock Text="Recycle Bin querying and emptying is performed strictly using the official Microsoft Shell32 API (SHEmptyRecycleBinW and SHQueryRecycleBinW)." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GNU General Public License v3.0 Card -->
                        <Border Grid.Row="2" Style="{StaticResource PilgrimCardStyle}" Margin="0,0,0,20">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Code24" Foreground="{StaticResource BrushPilgrimCyan}" FontSize="20" Margin="0,0,10,0" />
                                        <TextBlock Text="FREE &amp; OPEN SOURCE: GNU GENERAL PUBLIC LICENSE v3 (GPLv3)" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="#14263C" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                        <TextBlock Text="GNU GPLv3" FontWeight="Bold" FontSize="12.5" Foreground="#00E5FF" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="Pilgrim Cleaner is Free and Open Source Software developed by Pilgrim Software under the terms of the GNU General Public License as published by the Free Software Foundation, version 3 or later." FontSize="14" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="Copyright (C) 2026 Pilgrim Software. This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for full terms." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <Border Background="#0B131E" BorderBrush="#16273A" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="{StaticResource BrushPilgrimEmerald}" FontSize="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Freedom to run, study, modify, and redistribute this software freely without vendor lock-in." FontSize="13" FontWeight="SemiBold" Foreground="#00FF9D" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ==================== COLLAPSIBLE ACTION LOG DRAWER ==================== -->
                <Border Grid.Row="1"
                        Background="#09121E"
                        BorderBrush="#182A3E"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drawer Header Bar (always visible) -->
                        <Grid Grid.Row="0" Height="36" Margin="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="WindowConsole20" FontSize="15" Foreground="{StaticResource BrushPilgrimCyan}" Margin="0,0,8,0" />
                                <TextBlock Text="LIVE CONSOLE STATUS:" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentStatusText}" FontSize="12.5" Foreground="#00E5FF" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#94A3B8"
                                    Command="{Binding ToggleLogDrawerCommand}"
                                    Cursor="Hand"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IsLogDrawerOpen, Converter={StaticResource StringToVis}, ConverterParameter=True}" />
                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="15" Visibility="{Binding IsLogDrawerOpen, Converter={StaticResource BoolToVis}}" />
                                    <ui:SymbolIcon Symbol="ChevronUp24" FontSize="15" Visibility="{Binding IsLogDrawerOpen, Converter={StaticResource InvertedBoolToVis}}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Slide-Up Drawer Content -->
                        <Border Grid.Row="1"
                                Height="160"
                                Background="#05080E"
                                BorderBrush="#122030"
                                BorderThickness="0,1,0,0"
                                Padding="12,8"
                                Visibility="{Binding IsLogDrawerOpen, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ActionLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="Consolas, monospace" FontSize="12.5" Margin="0,1.5">
                                                <Run Text="[" Foreground="#475569" /><Run Text="{Binding FormattedTimestamp, Mode=OneWay}" Foreground="#64748B" /><Run Text="]" Foreground="#475569" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Tag, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding AccentColor, Mode=OneWay}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Message, Mode=OneWay}" Foreground="#CBD5E1" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
