<Application x:Class="LuminaCleaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:LuminaCleaner.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
            <conv:InvertedBooleanConverter x:Key="InvertedBool" />
            <conv:StringEqualsToVisibilityConverter x:Key="StringToVis" />
            <conv:StringEqualsToBooleanConverter x:Key="StringToBool" />
            <conv:RatioToAngleConverter x:Key="RatioToAngle" />
            <conv:CleanStatusToBrushConverter x:Key="CleanStatusToBrush" />
            <conv:GreaterThanZeroToVisibilityConverter x:Key="NumberToVis" />

            <!-- Pilgrim Software Brand Palette -->
            <Color x:Key="ColorPilgrimCyan">#00E5FF</Color>
            <Color x:Key="ColorPilgrimDeepBlue">#0032A0</Color>
            <Color x:Key="ColorPilgrimTeal">#00B4D8</Color>
            <Color x:Key="ColorPilgrimEmerald">#00FF9D</Color>
            <Color x:Key="ColorPilgrimDark">#0B121C</Color>
            <Color x:Key="ColorPilgrimSurface">#111C2B</Color>
            <Color x:Key="ColorPilgrimBorder">#1D2E42</Color>

            <SolidColorBrush x:Key="BrushPilgrimCyan" Color="{StaticResource ColorPilgrimCyan}" />
            <SolidColorBrush x:Key="BrushPilgrimDeepBlue" Color="{StaticResource ColorPilgrimDeepBlue}" />
            <SolidColorBrush x:Key="BrushPilgrimTeal" Color="{StaticResource ColorPilgrimTeal}" />
            <SolidColorBrush x:Key="BrushPilgrimEmerald" Color="{StaticResource ColorPilgrimEmerald}" />
            <SolidColorBrush x:Key="BrushPilgrimDark" Color="{StaticResource ColorPilgrimDark}" />
            <SolidColorBrush x:Key="BrushPilgrimSurface" Color="{StaticResource ColorPilgrimSurface}" />
            <SolidColorBrush x:Key="BrushPilgrimBorder" Color="{StaticResource ColorPilgrimBorder}" />

            <!-- Radiant Brand Gradients -->
            <LinearGradientBrush x:Key="BrushPilgrimGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0032A0" Offset="0.0" />
                <GradientStop Color="#0096C7" Offset="0.5" />
                <GradientStop Color="#00E5FF" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushPilgrimGlowButton" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0032A0" Offset="0.0" />
                <GradientStop Color="#00B4D8" Offset="0.5" />
                <GradientStop Color="#00E5FF" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushCardGlow" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A283C" Offset="0.0" />
                <GradientStop Color="#101A26" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Card Style -->
            <Style x:Key="PilgrimCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushCardGlow}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushPilgrimBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.25" ShadowDepth="4" Color="#000000" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Action Button Style -->
            <Style x:Key="PilgrimPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushPilgrimGlowButton}" />
                <Setter Property="Foreground" Value="#05101A" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="26,13" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="glow" BlurRadius="18" Color="#00E5FF" Opacity="0.4" ShadowDepth="0" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0045D8" Offset="0.0" />
                                                <GradientStop Color="#00E5FF" Offset="0.7" />
                                                <GradientStop Color="#80F2FF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="26" Color="#00E5FF" Opacity="0.75" ShadowDepth="0" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="50" CenterY="20" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                    <Setter TargetName="border" Property="Effect" Value="{x:Null}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary / Ghost Button Style -->
            <Style x:Key="PilgrimSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#122032" />
                <Setter Property="BorderBrush" Value="#1F3652" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#E2E8F0" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1C334E" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0F1B2B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Navigation Button Style -->
            <Style x:Key="PilgrimNavButtonStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#94A3B8" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Margin" Value="0,2,0,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="14,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Selection Bar Indicator -->
                                    <Border x:Name="indicator"
                                            Grid.Column="0"
                                            Width="3.5"
                                            Height="18"
                                            CornerRadius="2"
                                            Background="{StaticResource BrushPilgrimCyan}"
                                            Margin="-10,0,10,0"
                                            Visibility="Collapsed" />

                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#152438" />
                                    <Setter Property="Foreground" Value="#E2E8F0" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1A2D45" />
                                    <Setter Property="Foreground" Value="#00E5FF" />
                                    <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
